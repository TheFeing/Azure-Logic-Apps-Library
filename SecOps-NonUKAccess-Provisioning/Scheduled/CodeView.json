{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "type": "Recurrence",
                "recurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "UTC",
                    "schedule": {
                        "hours": [
                            0
                        ],
                        "minutes": [
                            1
                        ]
                    }
                }
            }
        },
        "actions": {
            "Get_items_-_Provisioning": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sharepointonline-1']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('YOUR_SITE_URL'))}/tables/@{encodeURIComponent(encodeURIComponent('2059d869-4830-41d5-85fb-229b6cf79902'))}/items",
                    "queries": {
                        "$filter": "FirstValidDate eq '@{utcNow('yyyy-MM-dd')}'"
                    }
                },
                "runAfter": {
                    "For_each_-_Removal": [
                        "Succeeded",
                        "Skipped",
                        "Failed",
                        "TimedOut"
                    ]
                }
            },
            "For_each_-_Provisioning": {
                "type": "Foreach",
                "foreach": "@body('Get_items_-_Provisioning')?['value']",
                "actions": {
                    "HTTP_-_Provisioning": {
                        "type": "Http",
                        "inputs": {
                            "uri": "https://graph.microsoft.com/v1.0/groups/@{variables('GroupID')}/members/$ref",
                            "method": "POST",
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "@@odata.id": "https://graph.microsoft.com/v1.0/directoryObjects/@{body('Get_user_profile_(V2)_-_Provisioning')?['id']}"
                            },
                            "authentication": {
                                "type": "ManagedServiceIdentity",
                                "audience": "https://graph.microsoft.com"
                            }
                        },
                        "runAfter": {
                            "Get_user_profile_(V2)_-_Provisioning": [
                                "Succeeded"
                            ]
                        },
                        "runtimeConfiguration": {
                            "contentTransfer": {
                                "transferMode": "Chunked"
                            }
                        }
                    },
                    "Get_user_profile_(V2)_-_Provisioning": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['office365users']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/codeless/v1.0/users/@{encodeURIComponent(items('For_each_-_Provisioning')?['UserUPN']?['Email'])}"
                        }
                    },
                    "Condition_-_AlreadyAddedError": {
                        "type": "If",
                        "expression": {
                            "and": [
                                {
                                    "contains": [
                                        "@body('HTTP_-_Provisioning')?['error']?['message']",
                                        "One or more added object references already exist for the following modified properties: 'members'."
                                    ]
                                }
                            ]
                        },
                        "actions": {},
                        "else": {
                            "actions": {
                                "Set_variable_-_UnknownError2": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "BenignError",
                                        "value": false
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "HTTP_-_Provisioning": [
                                "Failed"
                            ]
                        }
                    },
                    "Run_query_and_list_results_V2_-_GetAllDevices": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "query": "SigninLogs\n| where TimeGenerated >=ago(90d)\n| extend UPN_Lower = tolower(UserPrincipalName)\n| where UPN_Lower has_any (\n\"@{body('Get_user_profile_(V2)_-_Provisioning')?['mail']}\"\n)\n| extend DeviceName = tostring(DeviceDetail[\"displayName\"])\n| extend DeviceID = tostring(DeviceDetail[\"deviceId\"])\n| where DeviceName != \" \" and isnotempty(DeviceName)\n| where DeviceID != \" \" and isnotempty(DeviceID)\n| distinct  UPN_Lower, DeviceName, DeviceID",
                                "timerangetype": "3"
                            },
                            "path": "/queryDataV2",
                            "queries": {
                                "subscriptions": "YOUR_SUBSCRIPTION_ID",
                                "resourcegroups": "YOUR_RESOURCE_GROUP",
                                "resourcetype": "Log Analytics Workspace",
                                "resourcename": "YOUR_RESOURCE_GROUP"
                            }
                        },
                        "runAfter": {
                            "Condition_-_AlreadyAddedError": [
                                "Skipped"
                            ]
                        }
                    },
                    "For_each": {
                        "type": "Foreach",
                        "foreach": "@body('Run_query_and_list_results_V2_-_GetAllDevices')?['value']",
                        "actions": {
                            "Watchlists_-_Add_a_new_Watchlist_Item": {
                                "type": "ApiConnection",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['azuresentinel-1']['connectionId']"
                                        }
                                    },
                                    "method": "put",
                                    "body": {
                                        "UserPrincipalName": "@{body('Get_user_profile_(V2)_-_Provisioning')?['mail']}",
                                        "FirstValidDate": "@{items('For_each_-_Provisioning')?['FirstValidDate']}",
                                        "LastValidDate": "@{items('For_each_-_Provisioning')?['LastValidDate']}",
                                        "DeviceName": "@{items('For_each')?['DeviceName']}",
                                        "DeviceID": "@{items('For_each')?['DeviceID']}",
                                        "Country": "@{items('For_each_-_Provisioning')?['CountryCode']}",
                                        "AddedBy": "SecOps-NonUKAccess-Provisioning(Scheduled)",
                                        "Comment": "This is auto-added by [SecOps-NonUKAccess-Provisioning(Scheduled)] according to SharePoint list [YOUR_SHAREPOINT_LIST]"
                                    },
                                    "path": "/Watchlists/subscriptions/@{encodeURIComponent(variables('SubscriptionID'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/workspaces/@{encodeURIComponent(variables('WorkspaceID'))}/watchlists/@{encodeURIComponent('YOUR_WATCHLIST')}/watchlistItem"
                                }
                            }
                        },
                        "runAfter": {
                            "Run_query_and_list_results_V2_-_GetAllDevices": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_variable_-_UnknownError3": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "BenignError",
                            "value": false
                        },
                        "runAfter": {
                            "For_each": [
                                "Failed"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Get_items_-_Provisioning": [
                        "Succeeded"
                    ]
                }
            },
            "Terminate": {
                "type": "Terminate",
                "inputs": {
                    "runStatus": "Succeeded"
                },
                "runAfter": {
                    "Condition_-_BenignError": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "GroupID",
                            "type": "string",
                            "value": "YOUR_GROUP_ID"
                        },
                        {
                            "name": "BenignError",
                            "type": "boolean",
                            "value": true
                        },
                        {
                            "name": "SubscriptionID",
                            "type": "string",
                            "value": "YOUR_SUBSCRIPTION_ID"
                        },
                        {
                            "name": "WorkspaceID",
                            "type": "string",
                            "value": "YOUR_WORKSPACE_ID"
                        },
                        {
                            "name": "ResourceGroup",
                            "type": "string",
                            "value": "YOUR_RESOURCE_GROUP"
                        }
                    ]
                },
                "runAfter": {}
            },
            "Get_items_-_Removal": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('YOUR_SITE_URL'))}/tables/@{encodeURIComponent(encodeURIComponent('2059d869-4830-41d5-85fb-229b6cf79902'))}/items",
                    "queries": {
                        "$filter": "LastValidDate eq '@{addDays(utcNow(), -1, 'yyyy-MM-dd')}'"
                    }
                },
                "runAfter": {
                    "Initialize_variables": [
                        "Succeeded"
                    ]
                }
            },
            "For_each_-_Removal": {
                "type": "Foreach",
                "foreach": "@body('Get_items_-_Removal')?['value']",
                "actions": {
                    "Get_user_profile_(V2)_-_Removal": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['office365users']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/codeless/v1.0/users/@{encodeURIComponent(items('For_each_-_Removal')?['UserUPN']?['Email'])}"
                        }
                    },
                    "HTTP_-_Removal": {
                        "type": "Http",
                        "inputs": {
                            "uri": "@concat('https://graph.microsoft.com/v1.0/groups/', variables('GroupID'),'/members/', outputs('Get_user_profile_(V2)_-_Removal')?['body/id'], '/$ref')",
                            "method": "DELETE",
                            "authentication": {
                                "type": "ManagedServiceIdentity",
                                "audience": "https://graph.microsoft.com"
                            }
                        },
                        "runAfter": {
                            "Get_user_profile_(V2)_-_Removal": [
                                "Succeeded"
                            ]
                        },
                        "runtimeConfiguration": {
                            "contentTransfer": {
                                "transferMode": "Chunked"
                            }
                        }
                    },
                    "Condition_-_NotInGroupError": {
                        "type": "If",
                        "expression": {
                            "and": [
                                {
                                    "contains": [
                                        "@body('HTTP_-_Removal')?['error']?['message']",
                                        "does not exist or one of its queried reference-property objects are not present."
                                    ]
                                }
                            ]
                        },
                        "actions": {},
                        "else": {
                            "actions": {
                                "Set_variable_-_UnknownError1": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "BenignError",
                                        "value": false
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "HTTP_-_Removal": [
                                "Failed"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Get_items_-_Removal": [
                        "Succeeded"
                    ]
                }
            },
            "Condition_-_BenignError": {
                "type": "If",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@variables('BenignError')",
                                true
                            ]
                        }
                    ]
                },
                "actions": {},
                "else": {
                    "actions": {
                        "Post_message_in_a_chat_or_channel": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['teams']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "recipient": "19:b4ff9f1f050f43289da0e83f95d08dd8@thread.v2",
                                    "messageBody": "<p class=\"editor-paragraph\">Logic App \"<b><strong class=\"editor-text-bold\">SecOps-NonUKAccess-Provisioning(Scheduled)</strong></b>\" encountered unknown errors.</p><br><p class=\"editor-paragraph\">Visit <a href=\"https://portal.azure.com/#@YOUR_DOMAIN/resource/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Logic/workflows/SecOps-NonUKAccess-Provisioning(Scheduled)/runHistory\" class=\"editor-link\">this link</a> for more information.</p>"
                                },
                                "path": "/beta/teams/conversation/message/poster/Flow bot/location/@{encodeURIComponent('Group chat')}"
                            }
                        }
                    }
                },
                "runAfter": {
                    "For_each_-_Provisioning": [
                        "Succeeded",
                        "Failed",
                        "Skipped",
                        "TimedOut"
                    ]
                }
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sharepointonline-1": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/sharepointonline-2",
                    "connectionName": "sharepointonline-2",
                    "connectionProperties": {}
                },
                "office365users": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/office365users",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/office365users-1",
                    "connectionName": "office365users-1",
                    "connectionProperties": {}
                },
                "azuremonitorlogs": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/azuremonitorlogs",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/azuremonitorlogs-6",
                    "connectionName": "azuremonitorlogs-6",
                    "connectionProperties": {}
                },
                "azuresentinel-1": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/azuresentinel",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/azuresentinel-11",
                    "connectionName": "azuresentinel-11",
                    "connectionProperties": {}
                },
                "sharepointonline": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/sharepointonline-2",
                    "connectionName": "sharepointonline-2",
                    "connectionProperties": {}
                },
                "teams": {
                    "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/providers/Microsoft.Web/locations/ukwest/managedApis/teams",
                    "connectionId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Web/connections/teams-5",
                    "connectionName": "teams-5",
                    "connectionProperties": {}
                }
            }
        }
    }
}
