{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "type": "Recurrence",
                "recurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "UTC",
                    "schedule": {
                        "hours": [0],
                        "minutes": [1]
                    }
                }
            }
        },
        "actions": {
            "Initialize_variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "GroupID",
                            "type": "string",
                            "value": "<YOUR_TARGET_GROUP_ID>"
                        },
                        {
                            "name": "SubscriptionID",
                            "type": "string",
                            "value": "<YOUR_SUBSCRIPTION_ID>"
                        },
                        {
                            "name": "WorkspaceID",
                            "type": "string",
                            "value": "<YOUR_LOG_ANALYTICS_WORKSPACE_ID>"
                        },
                        {
                            "name": "ResourceGroup",
                            "type": "string",
                            "value": "<YOUR_RESOURCE_GROUP_NAME>"
                        },
                        {
                            "name": "BenignError",
                            "type": "boolean",
                            "value": true
                        }
                    ]
                }
            },
            "Get_items_-_Removal": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://<YOUR_TENANT>.sharepoint.com/sites/<YOUR_SITE>'))}/tables/@{encodeURIComponent(encodeURIComponent('<YOUR_LIST_ID>'))}/items",
                    "queries": {
                        "$filter": "LastValidDate eq '@{addDays(utcNow(), -1, 'yyyy-MM-dd')}'"
                    }
                },
                "runAfter": {
                    "Initialize_variables": ["Succeeded"]
                }
            },
            "For_each_-_Removal": {
                "type": "Foreach",
                "foreach": "@body('Get_items_-_Removal')?['value']",
                "actions": {
                    "Get_user_profile_(V2)_-_Removal": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['office365users']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/codeless/v1.0/users/@{encodeURIComponent(items('For_each_-_Removal')?['UserUPN']?['Email'])}"
                        }
                    },
                    "HTTP_-_Removal": {
                        "type": "Http",
                        "inputs": {
                            "uri": "@concat('https://graph.microsoft.com/v1.0/groups/', variables('GroupID'),'/members/', outputs('Get_user_profile_(V2)_-_Removal')?['body/id'], '/$ref')",
                            "method": "DELETE",
                            "authentication": {
                                "type": "ManagedServiceIdentity",
                                "audience": "https://graph.microsoft.com"
                            }
                        },
                        "runAfter": {
                            "Get_user_profile_(V2)_-_Removal": ["Succeeded"]
                        }
                    }
                },
                "runAfter": {
                    "Get_items_-_Removal": ["Succeeded"]
                }
            },
            "Get_items_-_Provisioning": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sharepointonline-1']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://<YOUR_TENANT>.sharepoint.com/sites/<YOUR_SITE>'))}/tables/@{encodeURIComponent(encodeURIComponent('<YOUR_LIST_ID>'))}/items",
                    "queries": {
                        "$filter": "FirstValidDate eq '@{utcNow('yyyy-MM-dd')}'"
                    }
                },
                "runAfter": {
                    "For_each_-_Removal": ["Succeeded", "Skipped", "Failed", "TimedOut"]
                }
            },
            "For_each_-_Provisioning": {
                "type": "Foreach",
                "foreach": "@body('Get_items_-_Provisioning')?['value']",
                "actions": {
                    "Get_user_profile_(V2)_-_Provisioning": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['office365users']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/codeless/v1.0/users/@{encodeURIComponent(items('For_each_-_Provisioning')?['UserUPN']?['Email'])}"
                        }
                    },
                    "HTTP_-_Provisioning": {
                        "type": "Http",
                        "inputs": {
                            "uri": "https://graph.microsoft.com/v1.0/groups/@{variables('GroupID')}/members/$ref",
                            "method": "POST",
                            "headers": { "Content-Type": "application/json" },
                            "body": {
                                "@@odata.id": "https://graph.microsoft.com/v1.0/directoryObjects/@{body('Get_user_profile_(V2)_-_Provisioning')?['id']}"
                            },
                            "authentication": {
                                "type": "ManagedServiceIdentity",
                                "audience": "https://graph.microsoft.com"
                            }
                        },
                        "runAfter": {
                            "Get_user_profile_(V2)_-_Provisioning": ["Succeeded"]
                        }
                    },
                    "Run_query_and_list_results_V2_-_GetAllDevices": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "query": "SigninLogs\n| where TimeGenerated >=ago(90d)\n| extend UPN_Lower = tolower(UserPrincipalName)\n| where UPN_Lower has_any (\"@{body('Get_user_profile_(V2)_-_Provisioning')?['mail']}\")\n| extend DeviceName = tostring(DeviceDetail[\"displayName\"])\n| extend DeviceID = tostring(DeviceDetail[\"deviceId\"])\n| where isnotempty(DeviceName) and isnotempty(DeviceID)\n| distinct UPN_Lower, DeviceName, DeviceID",
                                "timerangetype": "3"
                            },
                            "path": "/queryDataV2",
                            "queries": {
                                "subscriptions": "@variables('SubscriptionID')",
                                "resourcegroups": "@variables('ResourceGroup')",
                                "resourcetype": "Log Analytics Workspace",
                                "resourcename": "@variables('WorkspaceID')"
                            }
                        },
                        "runAfter": {
                            "HTTP_-_Provisioning": ["Succeeded", "Failed"]
                        }
                    }
                },
                "runAfter": {
                    "Get_items_-_Provisioning": ["Succeeded"]
                }
            },
            "Condition_-_BenignError": {
                "type": "If",
                "expression": {
                    "and": [
                        { "equals": ["@variables('BenignError')", true] }
                    ]
                },
                "actions": {},
                "else": {
                    "actions": {
                        "Post_message_in_a_chat_or_channel": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": { "name": "@parameters('$connections')['teams']['connectionId']" }
                                },
                                "method": "post",
                                "body": {
                                    "recipient": "<YOUR_TEAMS_CHANNEL_ID>",
                                    "messageBody": "<p>Logic App <b>SecOps-NonUKAccess-Provisioning(Scheduled)</b> encountered errors. Check run history in Azure Portal.</p>"
                                },
                                "path": "/beta/teams/conversation/message/poster/Flow bot/location/@{encodeURIComponent('Group chat')}"
                            }
                        }
                    }
                },
                "runAfter": {
                    "For_each_-_Provisioning": ["Succeeded", "Failed", "Skipped", "TimedOut"]
                }
            }
        },
        "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} }
        }
    }
}
